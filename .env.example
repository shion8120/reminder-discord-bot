# 設定すると収集結果を HTTP で公開する（Render の Web Service では自動で入る）
PORT=

# 任意。YouTube Data API v3 のキー。あると RSS より安定して取れる
YOUTUBE_API_KEY=

# 任意。Discord にも通知したいときの Webhook URL
DISCORD_WEBHOOK_URL=

# 確認間隔（分）
POLL_MINUTES=60

# これより古い動画は商品を拾わない（日）
MAX_AGE_DAYS=400

# Render では /var/data（Persistent Disk）
BOT_DATA_DIR=
