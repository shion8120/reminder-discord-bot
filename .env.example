# 収集結果の書き込み先。gadget-feed リポジトリだけに Contents: Read and write を付けた fine-grained トークン
GITHUB_TOKEN=
GITHUB_REPO=shion8120/gadget-feed
GITHUB_BRANCH=main

# 任意。YouTube Data API v3 のキー。あると RSS より安定して取れる（無料枠で足りる）
YOUTUBE_API_KEY=

# 任意。Discord にも通知したいときの Webhook URL。未設定ならコンソールに出す
DISCORD_WEBHOOK_URL=

# 確認間隔（分）
POLL_MINUTES=30

# 初回起動時に拾う範囲（日）。これより古い動画は既読扱い
INITIAL_LOOKBACK_DAYS=3

# Render では /var/data（Persistent Disk）
BOT_DATA_DIR=
