DISCORD_TOKEN=your-bot-token
DISCORD_CLIENT_ID=your-application-client-id
DISCORD_GUILD_ID=your-server-guild-id

# Optional: if set, reminders default to this text channel.
REMINDER_CHANNEL_ID=

# The bot treats slash-command dates as this timezone. Keep this as Asia/Tokyo for JST.
BOT_TIMEZONE=Asia/Tokyo

# Optional: set this to /var/data on Render when using a persistent disk.
BOT_DATA_DIR=
